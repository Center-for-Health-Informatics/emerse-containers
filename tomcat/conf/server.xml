<?xml version="1.0" encoding="UTF-8"?>
<!--
	Based on upstream/config/catalina-base/conf/server.xml. ${NAME} values come from the
	container environment (catalina.properties sets EnvironmentPropertySource); see
	compose.yaml and .env.example.

	The only listener is TLS on 8443: PHI crosses the aquarius → escher hop inside UC
	Health, and the published port must be firewalled to aquarius alone (README).
-->
<Server port="-1" shutdown="SHUTDOWN">
	<Listener className="org.apache.catalina.startup.VersionLoggerListener"/>
	<Listener className="org.apache.catalina.core.JreMemoryLeakPreventionListener"/>

	<Service name="Catalina">
		<Connector port="8443" protocol="org.apache.coyote.http11.Http11NioProtocol"
				SSLEnabled="true" scheme="https" secure="true"
				connectionTimeout="20000" maxParameterCount="1000"
				server="EMERSE">
			<SSLHostConfig protocols="TLSv1.2,TLSv1.3">
				<Certificate certificateFile="/run/secrets/tls.crt"
						certificateKeyFile="/run/secrets/tls.key"/>
			</SSLHostConfig>
		</Connector>

		<Engine name="Catalina" defaultHost="localhost">
			<!--
				First, while getRemoteAddr() is still the proxy that connected: verify
				CHI Authentication's SSO-Assertion and make its subject the remote user,
				which EMERSE's preauth profile reads (preauth.header left unset).
			-->
			<Valve className="edu.uc.chi.emerse.sso.SsoAssertionValve"
					jwksFile="/app/etc/chi-auth-jwks.json"
					issuer="${SSO_ISSUER}"
					audience="${SSO_AUDIENCE}"
					trustedProxies="${SSO_TRUSTED_PROXIES}"/>

			<!--
				Then recover the browser's address from X-Forwarded-For for EMERSE's audit
				tables and the access log: aquarius is internal, hermes's egress is trusted.
			-->
			<Valve className="org.apache.catalina.valves.RemoteIpValve"
					internalProxies="${CLIENT_IP_INTERNAL_PROXIES}"
					trustedProxies="${CLIENT_IP_TRUSTED_PROXIES}"
					remoteIpHeader="x-forwarded-for"
					protocolHeader="x-forwarded-proto"/>

			<Host name="localhost" appBase="webapps"
					unpackWARs="true" autoDeploy="false" deployOnStartup="true">
				<Valve className="org.apache.catalina.valves.ErrorReportValve"
						showReport="false"
						showServerInfo="false"/>
				<Valve className="org.apache.catalina.valves.AccessLogValve"
						directory="logs" maxDays="400"
						prefix="localhost_access_log" suffix=".txt"
						pattern="%h %l %u %t &quot;%r&quot; %s %b %D"/>
			</Host>
		</Engine>
	</Service>
</Server>
