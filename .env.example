# Copy to .env on chi-escher and adjust. Nothing here is secret; secrets/ holds those.
TZ=America/New_York
# the images build.sh pushes; pin TAG to a 7.2.1-g<sha> tag to roll back
REGISTRY=chi-tools.uc.edu
TAG=7.2.1

# the 1 TB mount: MariaDB, the Solr index, EMERSE resources, logs, backups
DATA_DIR=/srv/emerse/data
# deploy.sh puts the pinned CHI JWKS here
CONFIG_DIR=./etc/local

# escher's own address; firewall the port to chi-aquarius only
BIND_ADDRESS=10.52.31.13
HTTPS_PORT=8443

# emerse7 while v6 still serves /emerse; emerse at cutover
EMERSE_CONTEXT=emerse7

# where browsers reach it (hermes); CHI Authentication lives at $PUBLIC_ORIGIN/auth/
PUBLIC_ORIGIN=https://chi-tools.uc.edu
CHI_AUTH_JWKS_URL=https://chi-tools.uc.edu/auth/.well-known/jwks.json
SSO_ISSUER=https://chi-tools.uc.edu/auth/
SSO_AUDIENCE=chi-tools.uc.edu

# Regular expressions over the connecting address (single quotes keep the backslashes).
# Only chi-aquarius may present an SSO-Assertion.
SSO_TRUSTED_PROXIES='172\.31\.246\.247'
# For the client address in EMERSE's audit log: aquarius is internal; hermes's egress
# addresses (129.137.96.13, and 129.137.3.42 until confirmed retired) are trusted.
CLIENT_IP_INTERNAL_PROXIES='172\.31\.246\.247'
CLIENT_IP_TRUSTED_PROXIES='129\.137\.96\.13|129\.137\.3\.42'

# install guide: Tomcat 2 GB minimum; Solr about half of what's left, leaving page cache
TOMCAT_HEAP=4g
SOLR_HEAP=12g
